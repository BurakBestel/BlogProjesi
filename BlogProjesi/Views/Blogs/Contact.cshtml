<div class="mainbar">
    <div class="article">
        <h2><span>Iletişim</span></h2>
        <div class="clr"></div>
        <p>You can find more of my free template designs at my website. For premium commercial designs, you can check out DreamTemplate.com.</p>
    </div>
    <div class="article">
        <h2><span>Yorum</span> Yapın</h2>
        <div class="clr"></div>
        <form action="/Blogs/CreateContact" method="post" id="leavereply">
            <ol>
                
                <li>
                    <label for="name">Isim (Zorunlu)</label>
                    <input id="name" name="Name" class="text" required />
                </li>
                <li>
                    <label for="email">Email Addresi (Zorunlu)</label>
                    <input id="email" name="Email" class="text" required />
                </li>

                <li>
                    <label for="message">Yorumunuz</label>
                    <textarea id="message" name="Message" rows="8" cols="50"></textarea>
                </li>
                <li>
                    <input type="image" name="imageField" id="imageField" src="/images/submit.gif" class="send" />
                    <div class="clr"></div>
                </li>
            </ol>
        </form>
    </div>
    </div>
</div>